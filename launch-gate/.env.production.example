# Values to paste into Render -> Environment (NEVER commit a real .env).
# Lines marked AUTO are already set by render.yaml.

# AUTO: APP_ENV=production  REQUIRE_CLOUDINARY=true  JWT_SECRET  REDIS_URL  TRUSTED_PROXIES
# AUTO: META_MCP_ENABLE_LIVE=false  META_MCP_ALLOW_WRITES=false

# Supabase *Session pooler* string, with the psycopg-style prefix postgresql://
DATABASE_URL=postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Your Vercel address EXACTLY: https, no trailing slash, no path. Comma-separate extras.
FRONTEND_ORIGINS=https://your-app.vercel.app

# Cloudinary dashboard -> Settings -> API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google AI Studio key (without it the app runs in a reduced "heuristic" mode)
MODEL_API_KEY=

# Optional, add later for alert emails (otherwise alerts report "SMTP not configured")
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
# NOTIFICATION_FROM_EMAIL=alerts@yourdomain.com
