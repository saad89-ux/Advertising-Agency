# Local PostgreSQL connection string.
DATABASE_URL=
TEST_DATABASE_URL=

# Local Redis connection string.
REDIS_URL=
TEST_REDIS_URL=

# Hosted model provider key (Google Gemini API key from Google AI Studio).
MODEL_API_KEY=

# In-code model spend caps in USD (optional, defaults: $0.01 per row, $15.00 total).
SPEND_CAP_PER_ROW=0.01
SPEND_CAP_TOTAL=15.00

# Local file store directory.
STORAGE_DIR=storage

# Local API authentication and upload limits.
JWT_SECRET=replace-this-placeholder-before-running
JWT_EXPIRE_MINUTES=60
MAX_UPLOAD_BYTES=2097152
MAX_XLSX_UNCOMPRESSED_BYTES=20971520
MAX_EDIT_LOOPS=5

# Langfuse tracing (optional: traces fall back to PostgreSQL if unconfigured).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
