# ==============================================================================
# LaunchGate Production & Local Environment Configuration
# ==============================================================================

# Runtime mode. Local development uses STORAGE_DIR; production requires Cloudinary.
# NEXT_PUBLIC_API_BASE_URL: API origin used by the browser frontend (defaults to http://localhost:8000).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
APP_ENV=development
REQUIRE_CLOUDINARY=false

# Database: PostgreSQL connection string (Required for state, vector rules, and outbox)
DATABASE_URL=postgresql://postgres:password@localhost:5432/launch_gate
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/launch_gate_test

# Queue & Cache: Redis connection string (Required for background worker job queue)
REDIS_URL=redis://localhost:6379/0
TEST_REDIS_URL=redis://localhost:6379/1

# AI Model Provider: Google Gemini API Key from Google AI Studio (Required for real LLM checks & LLM Judge)
MODEL_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# LLM Cost Governance (USD): Spend caps per row and batch
SPEND_CAP_PER_ROW=0.01
SPEND_CAP_TOTAL=15.00

# External Cloud Storage: Cloudinary (Required for persistent image/video/document storage in production)
# Reason: Replaces ephemeral local disk storage so files persist across container deploys/restarts.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=launchgate_campaigns
# Alternatively, specify full URL:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Local Storage Directory (development/testing only; never used when APP_ENV=production)
STORAGE_DIR=storage

# Real-World Dynamic Client Support
# Reason: Set to 'true' to allow any external user/company domain to onboard dynamically.
ALLOW_DYNAMIC_CLIENTS=true

# Model Context Protocol (MCP) Remote Server Endpoints & Credentials
# Meta Ads Graph MCP Server (Official: https://mcp.facebook.com/ads)
MCP_META_SERVER_URL=https://mcp.facebook.com/ads
META_MCP_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_AD_ACCOUNT_CURRENCY=
# Explicit opt-in for remote Meta MCP reads/dispatches. Keep false for local testing.
META_MCP_ENABLE_LIVE=false
META_MCP_ALLOW_WRITES=false

# Alert Delivery Configuration (Phase 3A)
# Delivery Sink: 'dev' (default for local/testing) safely records simulated deliveries without external traffic.
# In production (APP_ENV=production), 'smtp' is required and 'dev' is strictly blocked.
NOTIFICATION_DELIVERY_SINK=dev
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_BACKOFF_SECONDS=2.0
# Retention policy for old terminal records (delivered/permanently_failed) in days
NOTIFICATION_RETENTION_DAYS=30

# Email Alerts: SMTP configuration (Required for HTML/plain-text alert notifications)
# Reason: Dispatches violation diagnostics, suspension warnings, and remediation notices to the
# launch contact email. Launch collection is email-only; no SMS provider is used.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
NOTIFICATION_FROM_EMAIL=alerts@launchgate.com

# Security & Authentication
JWT_SECRET=replace-this-placeholder-before-running-in-production-32ch
JWT_EXPIRE_MINUTES=60
# Reason: Limits signup and login attempts from each client IP per hour.
AUTH_RATE_LIMIT_PER_HOUR=20
# Opaque guest cookies are 256-bit random values; only their SHA-256 hashes are stored.
# APP_ENV=production enables Secure and SameSite=None (HTTPS required). Use an explicit
# FRONTEND_ORIGINS allowlist; cookie-authenticated POST requests require a matching Origin.
GUEST_SESSION_TTL_DAYS=30
MAX_UPLOAD_BYTES=2097152
MAX_XLSX_UNCOMPRESSED_BYTES=20971520
MAX_EDIT_LOOPS=5

# Observability & AI Telemetry: Langfuse (Optional, logs LLM generations, latency, and costs)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com


# Browser origins allowed to use the API, including handled server errors.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Comma-separated proxy IPs; empty means forwarded headers are ignored.
TRUSTED_PROXIES=
# Demo seeding is removed; this legacy setting is ignored.
SEED_DEMO_DATA=false
